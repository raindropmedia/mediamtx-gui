# === Kopiere diese Datei nach .env und passe die Werte an ===

# Zufaelliger, langer geheimer Schluessel fuer Sessions/CSRF (z.B. mit
# `openssl rand -hex 32` erzeugen). PFLICHT - ohne eigenen Wert startet die
# Anwendung nicht.
SECRET_KEY=

# Zusaetzlicher Schluessel, mit dem Zugangsdaten (Stream-Passwoerter,
# Docker-Zugang) verschluesselt in der Datenbank abgelegt werden.
# Mit `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` erzeugen.
# PFLICHT.
ENCRYPTION_KEY=

# Basis-URL der MediaMTX Control-API (innerhalb des Docker-Netzwerks meist
# der Containername von MediaMTX + Port 9997).
MTX_API_URL=http://mediamtx:9997

# Zugangsdaten fuer die Control-API. Siehe README, Abschnitt
# "MediaMTX vorbereiten" - ohne einen passenden authInternalUsers-Eintrag
# mit permission "api" kann die GUI nicht auf MediaMTX zugreifen, sobald
# authMethod: internal aktiv ist und die GUI nicht von 127.0.0.1 aus kommt.
MTX_API_USER=mediamtx-gui
MTX_API_PASS=

# Hostname/Adresse von MediaMTX aus Sicht des GUI-Containers, fuer RTSP-Pulls
# beim Snapshot-Erzeugen (meist identisch mit dem Host aus MTX_API_URL).
MTX_RTSP_HOST=mediamtx
MTX_RTSP_PORT=8554

# Optional: Basis-URL des MediaMTX Playback-Servers (Port 9996), falls
# `playback: yes` in mediamtx.yml gesetzt ist. Leer lassen, falls nicht genutzt.
MTX_PLAYBACK_URL=http://mediamtx:9996

# Oeffentlich erreichbarer Hostname/IP des Servers, wird fuer die
# angezeigten Verbindungs-URLs (RTSP/RTMP/HLS/WebRTC/SRT) verwendet.
PUBLIC_HOST=stream.example.com

# Docker-Container-Steuerung ist gesperrt: Der Docker-Socket wird nicht in
# den Container gemountet, und die GUI nutzt ihn nur, wenn zusaetzlich
# DOCKER_CONTROL_ENABLED=true gesetzt ist (nicht empfohlen - Zugriff auf den
# Docker-Socket ist gleichbedeutend mit Root-Rechten auf dem Host).
DOCKER_CONTROL_ENABLED=false
MTX_CONTAINER_NAME=

# Intervall in Sekunden, in dem neue Vorschaubilder gezogen werden.
SNAPSHOT_INTERVAL_SECONDS=15

# Sitzungsdauer in Minuten.
SESSION_MAX_AGE_MINUTES=480

# Erzwingt das "Secure"-Flag fuer das Session-Cookie und HSTS. Muss "true"
# bleiben, sobald die Anwendung (auch indirekt ueber einen Reverse-Proxy)
# per HTTPS erreichbar ist - sonst kann das Sitzungs-Cookie im Klartext
# mitgelesen werden. Nur fuer lokale Tests ohne TLS auf "false" setzen.
FORCE_SECURE_COOKIES=true

# Zeitzone fuer angezeigte Zeitpunkte (z.B. Gueltigkeit von QR-Codes).
DISPLAY_TIMEZONE=Europe/Berlin

# === StudioLink (Field-Reporter-App) - optional ===========================
# Basis-URL des StudioLink-Backends aus Sicht des GUI-Containers. Laeuft das
# Backend direkt auf dem Host (systemd), z.B.:
#   STUDIOLINK_API_URL=http://host.docker.internal:8787
# (dafuer steht in docker-compose.yml "extra_hosts: host.docker.internal:host-gateway";
# das Backend muss dann auf 0.0.0.0 oder der Docker-Bridge-IP lauschen).
# Leer = Menuepunkt "StudioLink" ausgeblendet.
STUDIOLINK_API_URL=
# adminToken aus der config.json des Backends (bzw. STUDIOLINK_ADMIN_TOKEN dort).
STUDIOLINK_ADMIN_TOKEN=
# Optional: abweichende JWKS-URL (Standard: <STUDIOLINK_API_URL>/.well-known/jwks.json)
STUDIOLINK_JWKS_URL=

# === MediaMTX-Anmeldung ueber diese GUI (authMethod: http) =================
# Aktiviert den Endpunkt /mtx/auth. Mit `openssl rand -hex 24` erzeugen und in
# mediamtx.yml eintragen:
#   authMethod: http
#   authHTTPAddress: http://<gui>:8080/mtx/auth?secret=<MTX_AUTH_SECRET>
#   authHTTPExclude: []
# Die GUI prueft dann die bisherigen authInternalUsers (unveraendert) UND die
# Tokens der StudioLink-App/Studiogeraete. Leer = Endpunkt deaktiviert.
MTX_AUTH_SECRET=
# Claim mit den Berechtigungen in den Tokens (wie authJWTClaimKey in MediaMTX).
MTX_JWT_CLAIM_KEY=mediamtx_permissions
